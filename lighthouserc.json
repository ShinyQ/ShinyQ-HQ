{
  "ci": {
    "collect": {
      "startServerCommand": "bun scripts/serve-static.ts --port 4320 --dir out",
      "startServerReadyPattern": "Serving",
      "startServerReadyTimeout": 30000,
      "url": [
        "http://127.0.0.1:4320/en?lhci-warmup=1",
        "http://127.0.0.1:4320/en",
        "http://127.0.0.1:4320/id",
        "http://127.0.0.1:4320/en/quick",
        "http://127.0.0.1:4320/en/journey",
        "http://127.0.0.1:4320/en/labs/voice-ai-contact-center",
        "http://127.0.0.1:4320/en/blog/making-a-voice-agent-interruptible",
        "http://127.0.0.1:4320/en/contact",
        "http://127.0.0.1:4320/en/cv",
        "http://127.0.0.1:4320/en/build"
      ],
      "numberOfRuns": 3,
      "settings": {
        "chromeFlags": "--no-sandbox"
      }
    },
    "assert": {
      "assertMatrix": [
        {
          "matchingUrlPattern": "^(?!.*/en/cv$)[^?]+$",
          "assertions": {
            "largest-contentful-paint": ["error", { "maxNumericValue": 2000, "aggregationMethod": "median-run" }],
            "cumulative-layout-shift": ["error", { "maxNumericValue": 0.01, "aggregationMethod": "median-run" }],
            "total-blocking-time": ["error", { "maxNumericValue": 200, "aggregationMethod": "median-run" }],
            "resource-summary:font:size": ["error", { "maxNumericValue": 61440 }],
            "resource-summary:document:size": ["error", { "maxNumericValue": 81920 }],
            "resource-summary:stylesheet:size": ["error", { "maxNumericValue": 20480 }],
            "resource-summary:script:size": ["error", { "maxNumericValue": 245760 }],
            "categories:performance": ["warn", { "minScore": 0.9 }],
            "categories:accessibility": ["warn", { "minScore": 0.9 }],
            "categories:seo": ["warn", { "minScore": 0.9 }]
          }
        },
        {
          "matchingUrlPattern": "/en/cv$",
          "assertions": {
            "largest-contentful-paint": ["warn", { "maxNumericValue": 2000, "aggregationMethod": "median-run" }],
            "cumulative-layout-shift": ["warn", { "maxNumericValue": 0.01, "aggregationMethod": "median-run" }],
            "total-blocking-time": ["warn", { "maxNumericValue": 200, "aggregationMethod": "median-run" }],
            "resource-summary:font:size": ["warn", { "maxNumericValue": 61440 }],
            "resource-summary:document:size": ["warn", { "maxNumericValue": 81920 }],
            "resource-summary:stylesheet:size": ["warn", { "maxNumericValue": 20480 }],
            "resource-summary:script:size": ["warn", { "maxNumericValue": 245760 }],
            "categories:performance": ["warn", { "minScore": 0.9 }],
            "categories:accessibility": ["warn", { "minScore": 0.9 }],
            "categories:seo": ["warn", { "minScore": 0.9 }]
          }
        }
      ]
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci"
    }
  }
}
