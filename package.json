{
  "name": "shinyq-hq",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "bun scripts/build-knowledge.ts && next build && bun scripts/defer-scripts.ts && bun scripts/root-redirect.ts && bun scripts/check-client-chunks.ts && bun scripts/csp-hashes.ts",
    "build:web": "bun scripts/build-knowledge.ts && next build && bun scripts/defer-scripts.ts && bun scripts/root-redirect.ts && bun scripts/check-client-chunks.ts && bun scripts/csp-hashes.ts",
    "serve": "bun scripts/serve-static.ts",
    "typecheck": "bun scripts/build-knowledge.ts && next typegen && tsc --noEmit",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:quick": "bun run typecheck && bun run lint && bun run test && bun run build && bun run og:check",
    "bench": "vitest bench --run --reporter=verbose",
    "e2e": "playwright test",
    "e2e:full": "bun scripts/e2e-changed.ts --all",
    "e2e:changed": "bun scripts/e2e-changed.ts",
    "e2e:smoke": "bun scripts/e2e-changed.ts --smoke",
    "e2e:shard": "bun scripts/e2e-shard.ts",
    "e2e:perf:shard": "PERF=1 bun scripts/e2e-shard.ts --grep-invert \"@nightly|@look\"",
    "e2e:durations": "bun scripts/e2e-durations.ts",
    "e2e:perf": "PERF=1 playwright test --grep-invert \"@nightly|@look\"",
    "e2e:timeline": "PERF=1 playwright test e2e/perf/timeline.spec.ts --workers=1",
    "e2e:look": "PERF=1 playwright test e2e/perf/look.spec.ts --workers=1",
    "screenshots": "SCREENSHOTS=1 playwright test e2e/screenshots.spec.ts --workers=1",
    "screenshots:pages": "SCREENSHOTS=1 playwright test e2e/pageview-visual.spec.ts --workers=1",
    "validate:content": "bun scripts/validate-fragment.ts full content/site-content.json",
    "build:knowledge": "bun scripts/build-knowledge.ts",
    "cv:pages": "bun scripts/cv-pages.ts",
    "paper:pages": "bun scripts/paper-pages.ts",
    "floor:thumbs": "SCREENSHOTS=1 playwright test e2e/screenshots.spec.ts -g \"floor thumbnail\" --workers=1 && bun scripts/floor-thumbs.ts",
    "og:check": "bun scripts/og-check.ts",
    "og:stills": "SCREENSHOTS=1 playwright test e2e/screenshots.spec.ts -g \"og still\" --workers=1 && bun scripts/og-stills.ts",
    "ask:eval": "bun scripts/ask-eval.ts"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@react-three/postprocessing": "^3.2.0",
    "next": "16.4.1",
    "next-intl": "^4.14.9",
    "next-mdx-remote": "^6.0.0",
    "postprocessing": "^6.39.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "^0.186.1",
    "troika-three-text": "^0.52.5",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/bun": "^1.4.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.1",
    "jsdom": "^30.1.3",
    "sharp": "0.35.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vitest": "^5.0.4",
    "wrangler": "4.151.0"
  },
  "packageManager": "bun@1.4.1",
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
